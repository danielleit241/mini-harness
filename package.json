{
  "name": "mini-harness",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.3.0"
  },
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env --import tsx src/cli/index.ts",
    "eval": "node --env-file=.env --import tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
