# AWS region where you have Bedrock model access enabled
AWS_REGION=us-east-1

# Most current Claude models on Bedrock only support on-demand invocation
# through an inference profile, not the bare model id — using the bare id
# fails with "on-demand throughput isn't supported". Use a profile id
# (prefixed "global.", "us.", "eu.", or "apac." depending on what your
# account has access to). List what you have with:
#   node -e "..." (see the "Checking available models" section in README.md)
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# AWS credentials are picked up automatically via the standard AWS SDK
# credential chain (env vars, shared ~/.aws/credentials profile, SSO, etc).
# If using env vars directly, uncomment and fill these in:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
